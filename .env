# Camiro environment variables
# Copy this to .env and fill in your values

# Anthropic API key (named API_KEY to avoid Railway interception)
API_KEY=sk-ant-api03-...

# Database
DATABASE_URL=postgresql://camiro:camiro@localhost:5432/camiro

# Optional: embedding provider
EMBEDDING_API_KEY=

# Optional: password gate for demo
DEMO_PASSWORD=

# Debug mode
DEBUG=false

# Security
REDACT_SECRETS=true
LOG_SUBMITTED_CODE=false
MAX_INPUT_CHARS=50000
API_KEY=your_fresh_key_here
DATABASE_URL=postgresql://camiro:camiro@localhost:5432/camiro
DATABASE_URL=postgresql://camiro:camiro@localhost:5432/camiro
