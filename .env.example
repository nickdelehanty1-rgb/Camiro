# Camiro environment variables
# Copy this to .env and fill in your values

# Anthropic API key (named API_KEY to avoid Railway interception)
API_KEY=sk-ant-api03-...

# LLM model (Railway can override without redeploy)
CAMIRO_MODEL=claude-fable-5

# Database
DATABASE_URL=postgresql://camiro:camiro@localhost:5432/camiro

# Optional: embedding provider
EMBEDDING_API_KEY=

# Optional: password gate for demo endpoints (leave blank for open access)
DEMO_PASSWORD=

# Rate limiting (scan requests per hour per IP)
RATE_LIMIT_PER_HOUR=10

# Debug mode
DEBUG=false

# Security
REDACT_SECRETS=true
LOG_SUBMITTED_CODE=false
MAX_INPUT_CHARS=50000
